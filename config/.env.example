# Copy to ../.env. Fixtures/mocks work with NO real keys — fill these only for live adapters.

# --- Safety gates (do NOT enable live in v1) ---
TRADING_MODE=paper            # paper | live  (live is out of scope for v1)
ALLOW_LIVE_ORDERS=false       # second gate; must ALSO be true for any live path

# --- LLM (provider-agnostic) ---
LLM_PROVIDER=mock             # mock | openai | anthropic
LLM_MODEL=                    # verify current id at build time (e.g. gpt-*, claude-*)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Market data / paper broker ---
MARKET_DATA_PROVIDER=fixture  # fixture | ccxt | alpaca
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# --- Alt-data (whale radar) ---
OPTIONS_FLOW_PROVIDER=fixture # fixture | unusualwhales | polygon
DARK_POOL_PROVIDER=fixture    # fixture | <provider>
SEC_EDGAR_USER_AGENT=         # EDGAR requires a contact string, e.g. "you@example.com"
OPTIONS_FLOW_API_KEY=
DARK_POOL_API_KEY=

# --- Memory ---
MEMORY_BACKEND=local          # local (sqlite) | cloud (postgres/supabase)
DATABASE_URL=                 # postgres URL when MEMORY_BACKEND=cloud
